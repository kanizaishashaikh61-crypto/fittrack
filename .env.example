# FitTrack account database
# Use a TLS-enabled MySQL-compatible database URL.
DATABASE_URL=mysql://user:password@host:3306/database
PORT=3000

# Optional AI Coach provider (OpenAI-compatible chat completions API)
AI_API_URL=https://api.openai.com
AI_API_KEY=your_api_key_here
FITTRACK_AI_MODEL=gpt-5-mini
